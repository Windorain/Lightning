{
  "private": true,
  "name": "lightning",
  "version": "0.0.0",
  "description": "Lightning — Minecraft structure data replay platform",
  "scripts": {
    "dev:web":           "cd web && npm run dev",
    "build:web":         "cd web && npm run build:all",
    "build:mod:gtnh":    "cd mod/gtnh && ./gradlew build",
    "build:all":         "npm run build:web && npm run build:mod:gtnh",
    "protocol:gen":      "cd protocol && buf generate",
    "protocol:lint":     "cd protocol && buf lint",
    "protocol:breaking": "cd protocol && buf breaking --against '.git#branch=main'",

    "multiblock:export":          "pwsh -NoProfile -File scripts/multiblock-pipeline/run-pipeline.ps1",
    "multiblock:verify-expanded": "node scripts/multiblock-pipeline/verify-expanded.mjs",
    "multiblock:compare-runs":    "node scripts/multiblock-pipeline/compare-runs.mjs",
    "multiblock:selfcheck":       "pwsh -NoProfile -File scripts/multiblock-pipeline/selfcheck.ps1",

    "acceptance:multiblock":      "pwsh -NoProfile -File scripts/acceptance/run-acceptance.ps1",
    "acceptance:volume-doc":      "node scripts/acceptance/volume-doc.mjs"
  }
}
