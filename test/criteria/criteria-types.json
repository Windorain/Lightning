    { "type": "event-emitted", "since": "1.0", "params": "kind, minCount(默认1)" },
    { "type": "image-size-equals", "since": "1.1", "params": "path, width, height" },
    { "type": "image-not-uniform", "since": "1.1", "params": "path, maxSameColorRatio(默认0.98)" },
    { "type": "te-state-equals", "since": "1.2", "params": "at[x,y,z], key(RFC 6901 指针，对描述器输出), expect(必填)" },
    { "type": "image-uniform", "since": "1.2", "params": "path, minSameColorRatio(默认0.98)" }
  ]
