{
  "schema": "lightning.case/1",
  "id": "ae2-parts",
  "label": "控制面 PR-3 锚点：AE2 缆块 + 部件（中心缆/切换总线/存储总线）——双轨判据 + K1 距离门对照（原版箱子 64 格 TESR 门，gate-near 门内箱在 / far 门外箱失）",
  "world": {
    "folder": "cp_ae2_parts",
    "seed": 20261006,
    "void": true,
    "base": [64, 12, 64],
    "settleTicks": 60
  },
  "build": [
    { "op": "clear", "from": [62, 10, 62], "to": [70, 16, 94] },

    { "op": "block", "at": [64, 12, 64], "id": "appliedenergistics2:tile.BlockCableBus", "meta": 0 },
    {
      "op": "te",
      "at": [64, 12, 64],
      "completer": "ae2-part",
      "params": {
        "parts": [
          { "item": "appliedenergistics2:item.ItemMultiPart", "meta": 16, "side": "UNKNOWN" },
          { "item": "appliedenergistics2:item.ItemMultiPart", "meta": 80, "side": "NORTH" },
          { "item": "appliedenergistics2:item.ItemMultiPart", "meta": 220, "side": "UP" }
        ]
      }
    },

    { "op": "block", "at": [65, 12, 64], "id": "appliedenergistics2:tile.BlockCableBus", "meta": 0 },
    {
      "op": "te",
      "at": [65, 12, 64],
      "completer": "ae2-part",
      "params": {
        "parts": [
          { "item": "appliedenergistics2:item.ItemMultiPart", "meta": 16, "side": "UNKNOWN" }
        ]
      }
    },

    { "op": "block", "at": [66, 12, 64], "id": "minecraft:chest", "meta": 3 },
    { "op": "te", "at": [66, 12, 64], "completer": "vanilla", "params": {} },

    { "op": "block", "at": [64, 12, 90], "id": "minecraft:chest", "meta": 3 },
    { "op": "te", "at": [64, 12, 90], "completer": "vanilla", "params": {} },

    { "op": "wait", "ticks": 20 }
  ],
  "capture": {
    "lighting": "natural",
    "renderMode": "本色",
    "worldTime": 6000
  },
  "cameras": [
    {
      "name": "near",
      "pos": [68.0, 14.0, 68.0],
      "yaw": 139.1,
      "pitch": 19.1,
      "projection": { "type": "perspective", "fov": 70 },
      "resolution": [1280, 720]
    },
    {
      "name": "ortho-top",
      "pos": [65.3, 18.0, 64.2],
      "yaw": 180.0,
      "pitch": 90.0,
      "projection": { "type": "ortho", "orthoHeight": 7.0 },
      "resolution": [1280, 720]
    },
    {
      "name": "gate-near",
      "pos": [64.5, 13.5, 120.5],
      "yaw": 180.0,
      "pitch": 2.0,
      "projection": { "type": "perspective", "fov": 8.0 },
      "resolution": [640, 360]
    },
    {
      "name": "far",
