{
  "schema": "lightning.case/1",
  "id": "tank-fill-live",
  "label": "#122 实机：scene.tank.fill 注入 HCl 3000 mB 到 LV 化学反应釜，read.te 读回储罐量一致（tanks 字段）；负对照变体：注入 20000 mB 超容量必红",
  "world": {
    "folder": "cp_tank122_case",
    "seed": 20261007,
    "void": true,
    "base": [64, 12, 64],
    "settleTicks": 60
  },
  "build": [
    { "op": "clear", "from": [63, 11, 63], "to": [70, 16, 70] },
    { "op": "te", "at": [65, 12, 65],
      "completer": "gt-machine",
      "params": { "machine": "Machine_LV_ChemicalReactor", "side": "UP" } }
  ],
  "read": [
    { "action": "read.te", "params": { "at": [65,12,65], "includeNbt": false },
      "path": "read/te-after-build.json", "role": "te-state" }
  ],
  "criteria": [
    { "id": "tank-machine-not-shell", "type": "te-state-equals",
      "params": { "at": [65,12,65], "key": "/shell" }, "expect": false },
    { "id": "tank-machine-meta-tile-id", "type": "te-state-equals",
      "params": { "at": [65,12,65], "key": "/metaTileId" }, "expect": 421 },
    { "id": "tank-capacity-is-16000", "type": "te-state-equals",
      "params": { "at": [65,12,65], "key": "/tanks/capacity" }, "expect": 16000 },
    { "id": "tank-empty-before-fill", "type": "te-state-equals",
      "params": { "at": [65,12,65], "key": "/tanks/tanks/0/amount" }, "expect": 0 },
    { "id": "tank-input-tank-is-empty-flag", "type": "te-state-equals",
      "params": { "at": [65,12,65], "key": "/tanks/tanks/0/empty" }, "expect": true },
    { "id": "tank-mte-capacity-is-16000", "type": "te-state-equals",
      "params": { "at": [65,12,65], "key": "/tanks/metaTileCapacity" }, "expect": 16000 },
    { "id": "world-hash-equals", "type": "world-hash-equals", "params": {} },
    { "id": "observation-exists", "type": "artifact-exists",
      "params": { "path": "observation.json" } }
  ],
  "variants": [
    {
      "id": "neg-setblock-shell",
      "mutate": [
        { "op": "replace", "path": "/build/1",
          "value": { "op": "block", "at": [65,12,65],
                     "id": "gregtech:gt.blockmachines", "meta": 1 } }
      ],
      "expectCriteriaRed": [
        "tank-machine-not-shell",
        "tank-machine-meta-tile-id",
        "tank-mte-capacity-is-16000"
      ]
    }
  ],
  "evidence": {
    "expect": [
      { "path": "observation.json", "role": "observation" },
      { "path": "criteria.json", "role": "criteria" },
      { "path": "read/te-after-build.json", "role": "te-state" }
    ]
  }
}
