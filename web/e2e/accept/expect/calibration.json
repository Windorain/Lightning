{
  "schema": "lightning.accept.expect/1",
  "scene": "calibration",
  "compare": {
    "pairs": "all-cameras",
    "normalize": "per-face-luminance",
    "exclude": [
      "sky"
    ],
    "thresholds": {
      "silhouetteIoU": 0.995,
      "faceColorDelta": 0.04,
      "seamEdgeMax": 0
    }
  },
  "checks": [
    {
      "kind": "region",
      "id": "anchor-white",
      "at": [
        0,
        0,
        0
      ],
      "expect": "block:wool-white"
    },
    {
      "kind": "region",
      "id": "axis-x-red",
      "at": [
        1,
        0,
        0
      ],
      "expect": "block:wool-red"
    },
    {
      "kind": "region",
      "id": "axis-z-green",
      "at": [
        0,
        0,
        1
      ],
      "expect": "block:wool-green",
      "cameras": [
        "back",
        "left",
        "right"
      ]
    },
    {
      "kind": "region",
      "id": "axis-y-blue",
      "at": [
        0,
        1,
        0
      ],
      "expect": "block:wool-blue",
      "cameras": [
        "front",
        "back",
        "left",
        "right"
      ]
    },
    {
      "kind": "region",
      "id": "glass-transparent",
      "at": [
        2,
        0,
        0
      ],
      "expect": "background",
      "cameras": [
        "front",
        "back"
      ]
    },
    {
      "kind": "silhouette",
      "id": "pair-silhouette"
    }
  ],
  "notes": "标定判据只回答两件事：(1) 四个标记的色度两侧一致（布局/朝向/纹理对）；(2) 玻璃在前/后机位透出背景。像素级落点由 verify/px-check.py 单独判（±1 px）。"
}
