{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lightning.accept.expect/1",
  "type": "object",
  "required": [
    "schema",
    "scene",
    "compare",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "lightning.accept.expect/1"
    },
    "scene": {
      "type": "string"
    },
    "compare": {
      "type": "object",
      "required": [
        "pairs",
        "normalize",
        "exclude",
        "thresholds"
      ],
      "additionalProperties": false,
      "properties": {
        "pairs": {
          "oneOf": [
            {
              "const": "all-cameras"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "normalize": {
          "enum": [
            "per-face-luminance",
            "none"
          ]
        },
        "exclude": {
          "type": "array",
          "items": {
            "enum": [
              "sky"
            ]
          }
        },
        "thresholds": {
          "type": "object",
          "required": [
            "silhouetteIoU",
            "faceColorDelta",
            "seamEdgeMax"
          ],
          "additionalProperties": false,
          "properties": {
            "silhouetteIoU": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "faceColorDelta": {
              "type": "number",
              "minimum": 0
            },
            "seamEdgeMax": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id"
        ],
        "additionalProperties": true,
        "properties": {
          "kind": {
            "enum": [
              "region",
              "seam",
              "opaque",
              "silhouette",
              "pair"
            ]
          },
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
