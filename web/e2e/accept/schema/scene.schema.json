{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lightning.accept.scene/1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "world",
    "blocks",
    "cameras",
    "export"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "lightning.accept.scene/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "world": {
      "type": "object",
      "required": [
        "region",
        "origin",
        "dim",
        "time",
        "weather"
      ],
      "additionalProperties": false,
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "dim": {
          "type": "integer",
          "minimum": -1,
          "maximum": 1
        },
        "time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24000
        },
        "weather": {
          "enum": [
            "clear",
            "rain",
            "thunder"
          ]
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "block",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "block": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "cameras": {
      "type": "object",
      "required": [
        "resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "views": {
          "type": "array",
          "items": {
            "enum": [
              "front",
              "back",
              "left",
              "right",
              "top",
              "bottom"
            ]
          },
          "uniqueItems": true
        },
        "axonometric": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "yaw",
              "pitch"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "yaw": {
                "type": "number"
              },
              "pitch": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            }
          }
        },
        "orthoHeight": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 160
          },
          "minItems": 2,
          "maxItems": 2
        },
        "explicit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "pos",
              "yaw",
              "pitch",
              "orthoHeight"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "pos": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "yaw": {
                "type": "number"
              },
              "pitch": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "orthoHeight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "required": [
        "name",
        "shape"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "shape": {
          "enum": [
            "world",
            "structure"
          ]
        }
      }
    }
  }
}
